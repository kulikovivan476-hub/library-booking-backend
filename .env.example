# Только для нового проекта библиотеки. Не копируйте .env проекта бара.
DB_USER=library
DB_NAME=library
DB_PASSWORD=
# Для запуска без Docker; внутри Docker Compose URL собирается автоматически.
DATABASE_URL=postgresql+asyncpg://library:your-password@localhost:5433/library
APP_TIMEZONE=Europe/Moscow
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SESSION_HOURS=24
